rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /projects/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false; // Writes go through authenticated server routes using Firebase Admin.
    }
    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false;
    }
    match /experiences/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false;
    }
    match /profile/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false;
    }
    match /siteSettings/{id} {
      allow read: if id == 'public' || isAdmin();
      allow write: if false;
    }
    match /users/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }
    match /messages/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
